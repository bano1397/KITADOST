            role = userData['role'] as String;
          } else {
            // Role field doesn't exist - check email and update database
            final userEmail = user.email?.toLowerCase() ?? '';
            role = (userEmail == 'banozahid1397@gmail.com') ? 'admin' : 'user';
            
            // Update the database with the role
