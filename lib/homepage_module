  // Helper function to build image widget that handles both Firebase Storage URLs and base64
  Widget buildBookImage(String? imageUrl, {required double height, required double iconSize, Color? backgroundColor}) {
    if (imageUrl == null || imageUrl.isEmpty) {
      return Center(
        child: Icon(
          Icons.menu_book,
          size: iconSize,
          color: Colors.white.withOpacity(0.8),
        ),
      );
    }

    // Check if it's a URL (starts with http:// or https://)
    final isUrl = imageUrl.startsWith('http://') || imageUrl.startsWith('https://');
    
    if (isUrl) {
      // It's a Firebase Storage URL
      return Image.network(
        imageUrl,
        fit: BoxFit.cover,
        width: double.infinity,
        height: height,
        errorBuilder: (context, error, stackTrace) {
          return Center(
            child: Icon(
              Icons.menu_book,
              size: iconSize,
              color: Colors.white.withOpacity(0.8),
            ),
          );
        },
        loadingBuilder: (context, child, loadingProgress) {
          if (loadingProgress == null) return child;
          return Center(
            child: CircularProgressIndicator(
              value: loadingProgress.expectedTotalBytes != null
                  ? loadingProgress.cumulativeBytesLoaded / loadingProgress.expectedTotalBytes!
                  : null,
              color: Colors.white.withOpacity(0.8),
            ),
          );
        },
      );
    } else {
      // It's base64 encoded
      try {
        return Image.memory(
          base64Decode(imageUrl),
          fit: BoxFit.cover,
          width: double.infinity,
          height: height,
          errorBuilder: (context, error, stackTrace) {
            return Center(
              child: Icon(
                Icons.menu_book,
                size: iconSize,
                color: Colors.white.withOpacity(0.8),
              ),
            );
          },
        );
      } catch (e) {
        return Center(
          child: Icon(
            Icons.menu_book,
            size: iconSize,
            color: Colors.white.withOpacity(0.8),
          ),
        );
      }
    }
  }

